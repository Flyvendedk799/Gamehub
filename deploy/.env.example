# Copy to deploy/.env and fill in. Never commit the real file.
#   cp deploy/.env.example deploy/.env

# ── Public identity ───────────────────────────────────────────────────────────
# Bare hostname, no scheme, no trailing slash. Its A/AAAA record must already
# point at this server before you start Caddy, or the TLS challenge will fail.
DOMAIN=gamehub.example.com

# Let's Encrypt sends expiry + problem notices here.
ACME_EMAIL=you@example.com

# ── Secrets ───────────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
# Encrypts users' BYOK provider keys at rest. Set it explicitly and NEVER change
# it after launch: it is not derived from anything, so rotating it makes every
# stored BYOK key permanently undecryptable.
API_KEY_ENCRYPTION_SECRET=
# Guards the /admin surface. Leave empty to disable admin routes entirely.
ADMIN_TOKEN=

# ── Generation provider ───────────────────────────────────────────────────────
# The key the platform bills generation against. Every game build is a multi-turn
# agent loop (build → playtest → repair), so this is real spend per game.
PLATFORM_API_KEY=
PLATFORM_PROVIDER=anthropic
# Repo default is claude-sonnet-4-6. Newer Claude models are available — check
# packages/providers for the ids this build accepts before changing it.
PLATFORM_MODEL_ID=claude-sonnet-4-6

# ── Concurrency ───────────────────────────────────────────────────────────────
# PER-USER cap enforced by the API (countActiveByUser -> 429). This is NOT a
# global limit — 50 users at 1 run each is still 50 runs.
MAX_CONCURRENT_RUNS=1

# THE global ceiling: parallel generations across the whole site. Everything
# above this waits in Redis instead of competing for RAM. Budget ~1.5 GB each.
#   4 GB box -> 1-2    8 GB -> 2-3    16 GB -> 4    32 GB -> 8
WORKER_CONCURRENCY=4

# Parallel Chromium instances for playtest/thumbnail jobs — the memory-hungry
# one. Keep at or below WORKER_CONCURRENCY; excess browser jobs just queue.
BROWSER_WORKER_CONCURRENCY=3

# ── Spend controls ────────────────────────────────────────────────────────────
# Hard token ceiling per run. Empty = no ceiling. Setting this is the single most
# effective guard against one runaway build draining the account.
MAX_RUN_TOKENS=

# WARNING — read before going public.
# The default credit provider is MockCreditProvider, which the source itself
# marks "NEVER use in production — no money changes hands": it confirms any
# purchase instantly and grants the credits for free. Left at `true` on a public
# URL with a funded PLATFORM_API_KEY, anyone who registers can mint UNLIMITED
# credits and spend your provider budget. Set false until real payments exist.
CREDIT_PURCHASE_ENABLED=false

# Separately: signup is ungated in this build, and registering grants
# FREE_TIER_CREDITS = 100. At CREDITS_PER_RUN = 10 that is 10 free generations
# per email address on your key, even with purchases disabled. Setting `false`
# above does NOT break signup — the welcome grant commits with the user row.

# ── Claude subscription (optional) ───────────────────────────────────────────
# Absolute path on the HOST to Claude Code's credentials file, written by
# `claude login`.
#
# The API runs in a container, so its `~` is the container's home and not
# yours. Without this the subscription cannot be connected no matter how many
# times you log in on the host — the connect attempt just reports
# "Claude Code is not logged in on this machine".
#
# Find it with:   ls -l ~/.claude/.credentials.json
# Typical value:  /root/.claude/.credentials.json
#
# Leave unset to use an API key instead (PLATFORM_API_KEY above).
CLAUDE_CREDENTIALS_FILE=
