# syntax=docker/dockerfile:1

# Gamehub web — Next.js 14 App Router shell.
FROM node:22-bookworm-slim

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app
COPY . .

# Dev deps are needed to BUILD (typescript, tailwind, postcss, autoprefixer).
RUN pnpm install --frozen-lockfile --prod=false

# Next.js inlines NEXT_PUBLIC_* into the client bundle at BUILD time, so this
# must be baked in — it cannot be supplied as a runtime env var.
#
# Set it to the PUBLIC site origin (e.g. https://gamehub.example.com), not an
# internal container address. Because Caddy serves the app and proxies /v1/* on
# that same origin, this value keeps API_BASE same-origin while still giving
# lib/config.ts a parseable absolute URL for API_WS_BASE (wss://…) and
# API_ORIGIN (the postMessage targetOrigin for the game iframe bridge).
# Leaving it empty would break API_ORIGIN, which falls back to localhost:3191.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# next.config.mjs bakes the /v1 rewrite DESTINATION into routes-manifest.json at
# BUILD time (rewrites are compiled, not read at runtime). So when the app is
# served WITHOUT an external path-router in front (i.e. the Next server itself
# proxies /v1/* → the API), API_PROXY_TARGET must be a build arg, not just a
# runtime env — otherwise it bakes the localhost:3191 default and every /v1 call
# ECONNREFUSEs inside the container. Harmless in the Caddy layout (Caddy handles
# /v1 before Next ever sees it); required in the single-service layout.
ARG API_PROXY_TARGET=http://api:3191
ENV API_PROXY_TARGET=$API_PROXY_TARGET

RUN test -n "$NEXT_PUBLIC_API_URL" || (echo "ERROR: NEXT_PUBLIC_API_URL build-arg is required" && exit 1)
RUN pnpm --filter @playforge/web build

ENV NODE_ENV=production \
    PORT=3004

EXPOSE 3004

CMD ["pnpm", "--filter", "@playforge/web", "start"]
