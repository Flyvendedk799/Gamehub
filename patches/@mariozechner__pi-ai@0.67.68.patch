+/**
+ * Opus 4.8 and the Claude 5 family (Sonnet 5 / 5.5, Opus 5 / 5.5, Fable 5 / 5.1, Mythos 5 / 5.1).
+ * Thinking is adaptive only: `{type:"enabled", budget_tokens}` and non-default sampling params
+ * (temperature / top_p / top_k) are rejected with a 400.
+ */
+function isAdaptiveOnlyGeneration(modelId) {
+    return /(opus-4[-.]8|opus-5|sonnet-5|fable-5|mythos-5)/.test(modelId);
+}
+/**
+ * How to turn thinking off on a model. `{type:"disabled"}` is a 400 on Sonnet 5.5 (which wants
+ * `{type:"between_tools"}`) and on the models where thinking is always on (Opus 5.5, Fable, Mythos),
+ * where the field has to be omitted instead.
+ */
+function thinkingOffMode(modelId) {
+    if (/sonnet-5[-.]5/.test(modelId))
+        return "between_tools";
+    if (/(opus-5[-.]5|fable-5|mythos-5)/.test(modelId))
+        return "omit";
+    return "disabled";
+}
+/** Forced `tool_choice` (`any` / `tool`) returns a 400 on these models; only `auto` / `none` are accepted. */
+function rejectsForcedToolChoice(modelId) {
+    return /(sonnet-5[-.]5|opus-5[-.]5|fable-5[-.]1|mythos-5[-.]1)/.test(modelId);
